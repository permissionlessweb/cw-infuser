      "ranges": [
        { "r_min": 210, "r_max": 245, "g_min": 110, "g_max": 145, "b_min": 45, "b_max": 75 }
      ]
    },
    {
      "id": "accent",
      "note": "Bright fiery orange highlight",
      "anchor": "color-accent",
      "members": ["color-accent"],
      "ranges": [
        { "r_min": 245, "r_max": 255, "g_min": 135, "g_max": 165, "b_min": 35, "b_max": 65 }
