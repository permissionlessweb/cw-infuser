# ── Chain / wallet ────────────────────────────────────────────────────────────
# MAIN_MNEMONIC=""
# TEST_MNEMONIC=""
# LOCAL_MNEMONIC=""
# STATE_FILE=
# ARTIFACTS_DIR=

# ── Merkle server (upload_merkle script) ──────────────────────────────────────
# secp256k1 private key (64-char hex, 32 bytes)
# Generate with: cargo run -p cw-infuser-scripts --bin merkle-server -- keygen
#   OR: cargo run -p merkle-server -- keygen
# MERKLE_PRIVATE_KEY=

# Base URL of the running merkle-server instance
# MERKLE_SERVER_URL=https://merkle.example.com

# ── Merkle server container (deploy.sdl.yaml / entrypoint.sh) ─────────────────
# Compressed secp256k1 public key (66-char hex, 33 bytes) — paired with MERKLE_PRIVATE_KEY
# MERKLE_PUBLIC_KEY=

# Cloudflare DNS hostname pointing at the Akash deployment
# DOMAIN=merkle.example.com

# Optional container overrides (defaults shown)
# MERKLE_DATA_DIR=/app/data
# MERKLE_PORT=8765
# MERKLE_TOLERANCE=300
